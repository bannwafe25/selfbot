# Salin file ini jadi .env lalu isi nilainya

# MongoDB connection string (WAJIB)
# Session bot & assistant disimpan di sini — tanpa ini bot minta login ulang
MONGODB_URI=

# Bot token dari @BotFather (WAJIB)
BOT_TOKEN=

# Groq API key dari https://console.groq.com (modul GenAI)
# Catatan: Gemini langsung GAGAL dari VPS tertentu (geo-block); pakai Groq
GROQ_API_KEY=

# Model GenAI (default qwen kalau kosong). Contoh: llama-3.3-70b-versatile
AI_MODEL=

# OneGrab API key (modul music: cari & download YouTube)
ONEGRAB_API_KEY=

# Opsional: path cookies YouTube (fallback .song/.vsong)
# YTDLP_COOKIES=/root/cookies.txt
